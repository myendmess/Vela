# Built frontend output — generated by the Vite build in web/ (see web/vite.config.js).
# Source of truth is web/src/**; never hand-edit anything below.
#
# -text            : opaque artifacts, never EOL-convert (keeps rebuilds byte-stable
#                    across Windows/Linux; minified JS/CSS otherwise shows spurious diffs)
# linguist-generated: collapse these in GitHub pull-request diffs and exclude them
#                    from repo language stats — reviewers see the web/src/ changes,
#                    not thousands of lines of minified bundle
globe/app/** -text linguist-generated=true
globe/index.html -text linguist-generated=true
globe/dashboard/index.html -text linguist-generated=true
